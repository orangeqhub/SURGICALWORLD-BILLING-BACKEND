# Copy to .env and fill in real values. NEVER commit the populated .env file.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surgical_world
DB_USER=postgres
DB_PASSWORD=
DB_LOGGING=false

# Test database (used by `npm test`)
DB_NAME_TEST=surgical_world_test

# --- Auth ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# Failed logins allowed per IP per 15 minutes (successful logins do not count).
LOGIN_RATE_LIMIT=10

# --- CORS ---
# Comma-separated list of allowed origins. Do NOT use "*" in production.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:5173

# --- Seed data (development only) ---
SEED_SUPER_ADMIN_LOGIN_ID=SA-001
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@123
SEED_BRANCH_CODE=BR-001
SEED_BRANCH_NAME=Main Branch
SEED_BRANCH_ADMIN_LOGIN_ID=BA-001
SEED_BRANCH_ADMIN_NAME=Branch Admin
SEED_BRANCH_ADMIN_PASSWORD=ChangeMe@123
SEED_EMPLOYEE_LOGIN_ID=EMP-001
SEED_EMPLOYEE_NAME=Sample Employee
SEED_EMPLOYEE_PASSWORD=ChangeMe@123